# Copy this file to .env.local and fill in your Supabase project's
# own values (Project Settings → API in the Supabase dashboard).
# Never commit .env.local — it is already in .gitignore.

# Safe to expose to the browser (NEXT_PUBLIC_*): the anon key is
# designed to be public. All real access control happens in Postgres
# via Row Level Security (see supabase/migrations/), not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix
# this with NEXT_PUBLIC_, never import it from a Client Component, and
# only use it from trusted server code: src/app/api/billing/webhook,
# src/app/api/billing/sweep, and src/lib/actions/billing.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billing (Asaas) — see docs/billing-integration.md for the full setup
# walkthrough (sandbox vs. production, registering the webhook,
# scheduling the sweep). All three are SERVER-ONLY.
#
# Leaving these unset is a valid, deliberate state during development:
# the checkout Server Action then fails closed with a clear
# "pagamento não configurado" error instead of pretending to succeed —
# it never falls back to marking anything paid on its own.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3

# Shared secret the external scheduler sends as
# `Authorization: Bearer <value>` when calling POST /api/billing/sweep.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Safe to expose to the browser — used to build the checkout return URL
# and the booking confirmation's cancel link. Set to your real deployed
# origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp booking confirmations — Meta's official WhatsApp Cloud API.
# See docs/whatsapp-integration.md for the full setup walkthrough
# (creating the Meta App, Embedded Signup, template approval,
# registering the webhook). Each company connects its OWN WhatsApp
# Business Account from Configurações — these vars configure the
# platform-wide Meta App that makes that possible, never a specific
# company's own credentials (those live encrypted in
# whatsapp_connections, set only via the app itself).
#
# Leaving these unset is a valid, deliberate state during development:
# a public booking still succeeds normally, it just never sends the
# WhatsApp confirmation (logged, not thrown) — never a reason a
# booking fails.
#
# SERVER-ONLY — from Meta for Developers → your App → App settings →
# Basic.
META_APP_ID=
META_APP_SECRET=
# Graph API version this app currently targets, e.g. "v21.0" — see
# developers.facebook.com/docs/graph-api/changelog for currently
# supported versions. Defaults to v21.0 if unset.
META_GRAPH_API_VERSION=
# A shared secret YOU choose (not provided by Meta) — enter this exact
# value when registering the webhook URL in the App Dashboard. Meta
# echoes it back on the one-time GET verification handshake; it is
# never sent on actual event deliveries, which are instead signed with
# META_APP_SECRET (see src/app/api/webhooks/whatsapp/route.ts).
META_WEBHOOK_VERIFY_TOKEN=
# Decrypts each company's own stored WhatsApp access token
# (whatsapp_connections.access_token_encrypted, AES-256-GCM) — never
# stored in the database itself. Generate with: openssl rand -hex 32
# Changing this after companies have connected invalidates every
# stored token (they would need to reconnect).
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Safe to expose to the browser — needed by the Embedded Signup button
# in Configurações (Meta's own JS SDK always takes a public app id,
# same trust model as NEXT_PUBLIC_SUPABASE_ANON_KEY above). Set
# NEXT_PUBLIC_META_APP_ID to the SAME value as META_APP_ID.
NEXT_PUBLIC_META_APP_ID=
# The Embedded Signup configuration id from Meta for Developers →
# your App → WhatsApp → Embedded Signup → Configurations — also not a
# secret (it only selects which signup flow to launch).
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional — defaults to v21.0 if unset. Keep in sync with
# META_GRAPH_API_VERSION above.
NEXT_PUBLIC_META_GRAPH_API_VERSION=
