# Copy this file to .env.local and fill in your Supabase project's
# own values (Project Settings → API in the Supabase dashboard).
# Never commit .env.local — it is already in .gitignore.

# Safe to expose to the browser (NEXT_PUBLIC_*): the anon key is
# designed to be public. All real access control happens in Postgres
# via Row Level Security (see supabase/migrations/), not by keeping
# this key secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix
# this with NEXT_PUBLIC_, never import it from a Client Component, and
# only use it from trusted server code: src/app/api/billing/webhook,
# src/app/api/billing/sweep, and src/lib/actions/billing.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Billing (Asaas) — see docs/billing-integration.md for the full setup
# walkthrough (sandbox vs. production, registering the webhook,
# scheduling the sweep). All three are SERVER-ONLY.
#
# Leaving these unset is a valid, deliberate state during development:
# the checkout Server Action then fails closed with a clear
# "pagamento não configurado" error instead of pretending to succeed —
# it never falls back to marking anything paid on its own.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3

# Shared secret the external scheduler sends as
# `Authorization: Bearer <value>` when calling POST /api/billing/sweep.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Safe to expose to the browser — used to build the checkout return URL
# and the booking confirmation's cancel link. Set to your real deployed
# origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp booking confirmations (Twilio) — see
# docs/whatsapp-integration.md for the full setup walkthrough (Sandbox
# vs. production, the owner's own WhatsApp number in Configurações,
# the Content Template text to submit for approval). All four are
# SERVER-ONLY.
#
# Leaving these unset is a valid, deliberate state during development:
# a public booking still succeeds normally, it just never sends the
# WhatsApp confirmation (logged, not thrown) — never a reason a
# booking fails. Twilio's free Sandbox mode (console.twilio.com →
# Messaging → Try it out → Send a WhatsApp message) lets you send real
# messages to a handful of test numbers with no business verification,
# before ever registering a production WhatsApp Business number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# e.g. "whatsapp:+14155238886" (Twilio's own Sandbox number) or your
# verified production WhatsApp sender.
TWILIO_WHATSAPP_FROM=
# A booking confirmation is business-initiated (the customer never
# messaged first), so WhatsApp requires it to go through a pre-approved
# Content Template rather than free-form text — Twilio's API rejects a
# plain-text send for this case with "ContentSid Required". This is
# that template's id ("HX...") from Twilio Console → Messaging →
# Content Template Builder, after Meta approves it. See
# docs/whatsapp-integration.md for the exact template text to submit.
TWILIO_CONTENT_SID=
